# Copy to .env and fill in. Free setup uses GROQ only.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk-...

# Force Groq for every node so no paid key is needed.
FAST_PROVIDER=groq
STRONG_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# Optional paid providers (leave unset for the free GROQ-only setup):
# ANTHROPIC_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
